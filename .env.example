# cluster-dashboard — environment template.
#
# Copy this file to .env and fill in real values. .env is gitignored.
# Anything missing here is silently disabled by the daemon.

# --- Telegram alerts (optional) ----------------------------------------------
# Get the bot token from @BotFather; the chat id is the numeric id of a
# group where the bot is admin (use @RawDataBot to find it).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --- LAN monitoring: traffic by interface -----------------------------------
# Override these only if the defaults from docker-compose.yml don't match
# your host. IFACE is the LAN-facing NIC; the dashboard container must
# be running with `network_mode: host` for these counters to reflect
# actual host traffic.
#
# LAN_SUBNET is the subnet the ARP scanner uses to populate the
# "Dispositivos LAN" card. If your ISP router moved you to a different
# /24, change this.
IFACE=enp2s0
IFACE_POLL_INTERVAL_MS=30000
IFACE_HISTORY_SAMPLES=1440
LAN_SUBNET=192.168.1.0/24
LAN_POLL_INTERVAL_MS=60000
LAN_HISTORY_SAMPLES=720
