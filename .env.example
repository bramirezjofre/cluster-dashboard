# cluster-dashboard — environment template.
#
# Copy this file to .env and fill in real values. .env is gitignored.
# Anything missing here is silently disabled by the daemon.

# --- Telegram alerts (optional) ----------------------------------------------
# Get the bot token from @BotFather; the chat id is the numeric id of a
# group where the bot is admin (use @RawDataBot to find it).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --- LAN monitoring: Pi-hole instances --------------------------------------
# Each pair PIHOLE_HOST_N + PIHOLE_PASSWORD_N becomes one Pi-hole polled
# for DNS stats. Format PIHOLE_HOST_N is "host:port" (e.g. 192.168.0.11:8080).
# Up to 5 instances supported by entrypoint.sh; add more there if needed.
# Leave both blank to disable a slot.
PIHOLE_HOST_1=192.168.0.11:8080
PIHOLE_PASSWORD_1=__REPLACE_ME__

PIHOLE_HOST_2=192.168.0.18:80
PIHOLE_PASSWORD_2=__REPLACE_ME__
