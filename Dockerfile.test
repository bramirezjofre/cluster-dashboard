# cluster-dashboard — test image.
#
# Standalone image that runs the unit tests in src/*.test.js with
# `node --test`. It doesn't need any runtime deps (the test files only
# read src/server.js as text and assert on its wiring, not on runtime
# behaviour).
#
# Build:    docker build -f Dockerfile.test -t cluster-dashboard-test .
# Run:      docker run --rm cluster-dashboard-test
# Or once:  docker run --rm cluster-dashboard-test && echo OK

FROM node:26-alpine

WORKDIR /app

# Only the test files and the modules they cover are needed.
# No package.json, no npm install, no native deps.
#
# The LAN scanner modules (arp.js, lan_enrich.js, iface_traffic.js) were
# deleted on 2026-10-26 along with the LAN feature that triggered the
# daemon's SIGSEGV; src/lan-removal.test.js locks that in.
#
# Regression test for the ssh2 stream-error crash. It reads src/server.js
# as text (it asserts on the handler wiring, not on runtime behaviour),
# so server.js has to be copied in too.
COPY src/server.js                 ./src/server.js
COPY src/ssh-error-handling.test.js ./src/ssh-error-handling.test.js
COPY src/lan-removal.test.js       ./src/lan-removal.test.js

# Run all *.test.js files under src/. `node --test` discovers tests
# when given a glob pattern. --test-reporter=spec gives readable output
# in `docker run`. The shell expands the glob; if you invoke this image
# with `docker run` directly you may need a shell (see entrypoint alt
# below).
CMD ["node", "--test", "--test-reporter=spec", "src/*.test.js"]

# Alternative for direct `docker run` invocations that bypass the shell:
# uncomment this line and comment the CMD above if you'd rather have
# docker invoke a shell that expands the glob.
# ENTRYPOINT ["sh", "-c", "node --test --test-reporter=spec 'src/*.test.js'"]
