# cluster-dashboard — environment template.
#
# Copy this file to .env and fill in real values. .env is gitignored.
# Anything missing here is silently disabled by the daemon.

# --- Telegram alerts (optional) ----------------------------------------------
# Get the bot token from @BotFather; the chat id is the numeric id of a
# group where the bot is admin (use @RawDataBot to find it).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --- Uptime Kuma (optional) --------------------------------------------------
# Service-level monitoring. The dashboard scrapes Kuma's /metrics endpoint
# with the API key and renders the result in the "Servicios" card.
#
# Kuma is a pure sensor: it probes the services, the dashboard announces
# them. Kuma's own Telegram notification is disabled so there is a single
# alerting path (and a single bot token) in the stack.
#
# The API key is created in the Kuma UI (Settings -> API Keys). It is the
# PLAINTEXT form — Kuma only stores a bcrypt hash of it, so it cannot be
# recovered from the database if lost. Keep this file at 600.
#
# KUMA_URL accepts the base URL or the full metrics URL; the dashboard
# appends /metrics when it is missing.
KUMA_URL=http://192.168.1.5:3002
KUMA_API_KEY=uk1_...
